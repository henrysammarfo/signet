# SIGNET — Vercel environment variables
# Project Settings → Environment Variables → paste each KEY=VALUE (Production + Preview)

# ── Required (frontend SSR + server functions) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public-facing x402 API (your Railway/deployed backend URL)
VITE_X402_SERVER_URL=https://your-x402-server.up.railway.app
X402_SERVER_URL=https://your-x402-server.up.railway.app

# CORS: your Vercel domain(s), comma-separated
VITE_APP_ORIGIN=https://your-app.vercel.app

# ── Agent automation (server functions / demo) ──
AVM_ADDRESS=
ANALYST_MNEMONIC=
BUYER_MNEMONIC=
BUYER_ADDRESS=

# ── Integrations ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALPHA_API_KEY=
ALPHA_NETWORK=testnet

# ── Optional ──
FACILITATOR_URL=https://facilitator.goplausible.xyz
SIGNAL_PRICE_USDC=0.01
AUTO_STAKE_XALGO=false
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
