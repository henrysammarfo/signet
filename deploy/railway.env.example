# SIGNET x402 server — Railway environment variables
# Deploy with Root Directory = `server`
# Service → Variables → paste each KEY=VALUE

# ── Required ──
PORT=4021
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AVM_ADDRESS=
ANALYST_MNEMONIC=
BUYER_MNEMONIC=
BUYER_ADDRESS=

# ── x402 ──
FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_SERVER_URL=https://your-x402-server.up.railway.app

# CORS: your Vercel frontend URL(s), comma-separated
VITE_APP_ORIGIN=https://your-app.vercel.app

# ── Integrations ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALPHA_API_KEY=
ALPHA_NETWORK=testnet
SIGNAL_PRICE_USDC=0.01

# ── Algorand ──
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud

# ── Optional Folks auto-stake ──
AUTO_STAKE_XALGO=false
FOLKS_XALGO_APP_ID=
FOLKS_XALGO_ASA_ID=
